{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

"title": {
  "text": "Population Pyramid: 1901 vs 2021",
  "font": "Montserrat",
  "fontSize": 18,
  "color": "#333",
  "anchor": "start"
},

  "background": "#F7EFEA",
  "height": 290,
  "width": 290,


  "config": {
    "font": "Rubik",
    "axis": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "labelColor": "#333",
      "titleColor": "#333"
    },
    "legend": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "orient": "bottom"
    }
  },

  "data": {
    "url": "data/population_dist.csv"
  },

  "transform": [
    {
      "fold": ["1901", "2021"],
      "as": ["Year", "Population"]
    },

    {
      "joinaggregate": [
        {"op": "sum", "field": "Population", "as": "TotalPop"}
      ],
      "groupby": ["Year"]
    },

    {
      "calculate": "datum.Population / datum.TotalPop",
      "as": "Percent"
    },

    {
      "calculate": "datum.Sex == 'Male' ? -datum.Percent : datum.Percent",
      "as": "Value"
    }
  ],

  "mark": {"type": "bar"},

  "encoding": {
    "column": {
      "field": "Year",
      "type": "nominal",
      "title": null,
      "sort": ["1901", "2021"]
    },

    "y": {
      "field": "Age",
      "type": "ordinal",
      "sort": [
        "85 and over","80-84","75-79","70-74","65-69","60-64","55-59",
        "50-54","45-49","40-44","35-39","30-34","25-29","20-24",
        "15-19","10-14","5-9","0-4"
      ],
      "title": "Age group"
    },

    "x": {
      "field": "Value",
      "type": "quantitative",
      "axis": {
        "title": "% of total population",
        "labelExpr": "abs(datum.value) * 100 + '%'"
      }
    },

    "color": {
      "field": "Sex",
      "type": "nominal",
      "scale": {
        "domain": ["Male", "Female"],
        "range": ["#76b7b2", "#e15759"]
      }
    },

    "tooltip": [
      {"field": "Sex"},
      {"field": "Age"},
      {"field": "Percent", "format": ".1%"},
      {"field": "Year"}
    ]
  }
}
