{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "#F7EFEA",
  "width": 240,
  "height": 240,

  "title": {
    "text": "Overseas-Born Population Share by State (2021)",
    "font": "Montserrat",
    "fontSize": 16,
    "color": "#333",
    "anchor": "start"
  },

  "data": {
    "values": [
      {"state": "Western Australia", "value": 34.1},
      {"state": "Victoria", "value": 31.7},
      {"state": "New South Wales", "value": 31.0},
      {"state": "Australian Capital Territory", "value": 29.8},
      {"state": "South Australia", "value": 25.1},
      {"state": "Queensland", "value": 24.2},
      {"state": "Northern Territory", "value": 23.9},
      {"state": "Tasmania", "value": 16.3}
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#e15759",
        "strokeWidth": 5
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": "% Overseas-born"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "title": null
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 250,
        "color": "#e15759",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x"
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "value", "title": "% Overseas-born"}
        ]
      }
    }
  ],

  "config": {
    "axis": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "labelColor": "#333",
      "titleColor": "#333"
    }
  }
}