{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
  "text": "Population Growth, 1980–2021",
  "font": "Montserrat",
  "fontSize": 18,
  "color": "#333",
  "anchor": "start"
},

  "background": "#F7EFEA",
  "width": 580,
  "config": {
    "font": "Rubik",
    "axis": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "labelColor": "#333",
      "titleColor": "#333"
    },
    "legend": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "orient": "bottom"
    }
  },

  "data": {
    "url": "data/population.csv"
  },

  "transform": [
    {
      "calculate": "datum.Age=='0-4' || datum.Age=='5-9' || datum.Age=='10-14' ? '0-14' : (datum.Age=='15-19' || datum.Age=='20-24' || datum.Age=='25-29' || datum.Age=='30-34' || datum.Age=='35-39' || datum.Age=='40-44' || datum.Age=='45-49' || datum.Age=='50-54' || datum.Age=='55-59' || datum.Age=='60-64' ? '15-64' : '65+')",
      "as": "AgeGroup"
    },

    {
      "fold": [
        "1950","1951","1952","1953","1954","1955","1956","1957","1958","1959",
        "1960","1961","1962","1963","1964","1965","1966","1967","1968","1969",
        "1970","1971","1972","1973","1974","1975","1976","1977","1978","1979",
        "1980","1981","1982","1983","1984","1985","1986","1987","1988","1989",
        "1990","1991","1992","1993","1994","1995","1996","1997","1998","1999",
        "2000","2001","2002","2003","2004","2005","2006","2007","2008","2009",
        "2010","2011","2012","2013","2014","2015","2016","2017","2018","2019",
        "2020","2021"
      ],
      "as": ["Year", "Population"]
    },

    {
      "filter": "toNumber(datum.Year) >= 1980"
    },

    {
      "aggregate": [
        {"op": "sum", "field": "Population", "as": "GroupPopulation"}
      ],
      "groupby": ["AgeGroup", "Year"]
    },

    {
      "window": [
        {"op": "lag", "field": "GroupPopulation", "as": "PrevPop"}
      ],
      "sort": [{"field": "Year"}],
      "groupby": ["AgeGroup"]
    },

    {
      "calculate": "(datum.GroupPopulation - datum.PrevPop) / datum.PrevPop",
      "as": "GrowthRate"
    }
  ],

  "layer": [
    {
      "mark": {"type": "area", "opacity": 0.7},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "GroupPopulation",
          "type": "quantitative",
          "title": "Population Count"
        },
        "color": {
          "field": "AgeGroup",
          "type": "nominal",
          "title": "Age Group"
        }
      }
    },

    {
      "transform": [{"filter": "datum.AgeGroup == '65+'"}],
      "mark": {"type": "line", "color": "black", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {
          "field": "GrowthRate",
          "type": "quantitative",
          "axis": {"title": "65+ Growth Rate", "orient": "right"},
          "scale": {"domain": [-0.02, 0.05]}
        },
        "tooltip": [
          {"field": "Year"},
          {"field": "GrowthRate", "format": ".2%"}
        ]
      }
    }
  ],

  "resolve": {
    "scale": {"y": "independent"}
  }
}
