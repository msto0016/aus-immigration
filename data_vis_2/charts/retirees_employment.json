{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Retirees vs Employed Persons and Support Ratio",
    "font": "Montserrat",
    "fontSize": 18,
    "color": "#333",
    "anchor": "start"
  },
  "width": 480,
  "height": 280,

  "background": "#F7EFEA",

  "config": {
    "font": "Rubik",
    "axis": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "labelColor": "#333",
      "titleColor": "#333"
    },
    "legend": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "orient": "bottom"
    }
  },

  "data": {
    "url": "data/retirees_workforce.csv"
  },

  "transform": [
    {
      "fold": ["retirees_000", "employed_total_000"],
      "as": ["category", "value"]
    },
    {
      "calculate": "datum.employed_total_000 / datum.retirees_000",
      "as": "support_ratio"
    },
    {
      "calculate": "datum.category == 'retirees_000' ? 'Retirees' : 'Employed persons'",
      "as": "category_label"
    }
  ],

  "layer": [
    {
      "mark": {"type": "bar"},
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelAngle": 0}
        },
        "xOffset": {"field": "category_label"},
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "People (000s)"
        },
        "color": {
          "field": "category_label",
          "type": "nominal",
          "title": "Group",
          "scale": {
            "domain": ["Retirees", "Employed persons"],
            "range": ["#e15759", "#4e79a7"]
          }
        },
        "tooltip": [
          {"field": "year"},
          {"field": "category_label", "title": "Group"},
          {"field": "value", "title": "Count (000s)"}
        ]
      }
    },

    {
      "mark": {
        "type": "line",
        "color": "#333",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {
          "field": "support_ratio",
          "type": "quantitative",
          "title": "Support Ratio (workers per retiree)",
          "axis": {"orient": "right"}
        },
        "tooltip": [
          {"field": "year"},
          {"field": "support_ratio", "format": ".2f"}
        ]
      }
    }
  ],

  "resolve": {"scale": {"y": "independent"}}
}
