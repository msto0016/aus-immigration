{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Global Origins of Australia's Population, 2025",
    "font": "Montserrat",
    "fontSize": 18,
    "anchor": "start",
    "color": "#333"
  },

  "background": "#F7EFEA",
  "height": 420,
  "width": 700,

  "config": {
    "font": "Rubik",
    "axis": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "labelColor": "#333",
      "titleColor": "#333"
    },
    "legend": {
      "labelFont": "Rubik",
      "titleFont": "Montserrat",
      "titleColor": "#333",
      "labelColor": "#333"
    }
  },

  "projection": {
    "type": "equalEarth",
    "center": [80, 5],
    "scale": 200
  },

  "layer": [

    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e6dfd8", "stroke": "#bbb"}
    },

    {
      "data": {"url": "data/birth_countries.csv"},

      "transform": [
        {
          "lookup": "country",
          "from": {
            "data": {
              "values": [
                {"country": "India", "lat": 20.5937, "lon": 78.9629},
                {"country": "England", "lat": 52.3555, "lon": -1.1743},
                {"country": "China", "lat": 35.8617, "lon": 104.1954},
                {"country": "New Zealand", "lat": -40.9006, "lon": 174.8860},
                {"country": "Philippines", "lat": 12.8797, "lon": 121.7740},
                {"country": "Vietnam", "lat": 14.0583, "lon": 108.2772},
                {"country": "South Africa", "lat": -30.5595, "lon": 22.9375},
                {"country": "Nepal", "lat": 28.3949, "lon": 84.1240},
                {"country": "Sri Lanka", "lat": 7.8731, "lon": 80.7718},
                {"country": "Malaysia", "lat": 4.2105, "lon": 101.9758}
              ]
            },
            "key": "country",
            "fields": ["lat", "lon"]
          }
        },

        {"calculate": "-25.2744", "as": "aus_lat"},
        {"calculate": "133.7751", "as": "aus_lon"},

        {
          "calculate": "[(datum.lon + datum.aus_lon)/2 + 10, (datum.lat + datum.aus_lat)/2 - 5]",
          "as": "mid"
        },

        {"calculate": "[datum.lon, datum.lat]", "as": "origin"},
        {"calculate": "[datum.origin, datum.mid, [datum.aus_lon, datum.aus_lat]]", "as": "curve_points"},
        {"flatten": ["curve_points"]},
        {"calculate": "datum.curve_points[0]", "as": "lon2"},
        {"calculate": "datum.curve_points[1]", "as": "lat2"}
      ],

      "mark": {
        "type": "line",
        "stroke": "#e15759",
        "curve": "basis"
      },

      "encoding": {
        "longitude": {"field": "lon2"},
        "latitude": {"field": "lat2"},
        "detail": {"field": "country"},
        "size": {
    "field": "migrants",
  "type": "quantitative",
  "scale": {"range": [1, 6]},
  "legend": {
    "title": "Migrants",
    "symbolStrokeWidth": 6,
    "symbolSize": 200
  }
},
        "strokeOpacity": {
          "field": "migrants",
          "type": "quantitative",
          "scale": {"range": [0.3, 0.9]}
        }
      }
    },

    {
      "data": {"url": "data/birth_countries.csv"},

      "transform": [
        {
          "lookup": "country",
          "from": {
            "data": {
              "values": [
                {"country": "India", "lat": 20.5937, "lon": 78.9629},
                {"country": "England", "lat": 52.3555, "lon": -1.1743},
                {"country": "China", "lat": 35.8617, "lon": 104.1954},
                {"country": "New Zealand", "lat": -40.9006, "lon": 174.8860},
                {"country": "Philippines", "lat": 12.8797, "lon": 121.7740},
                {"country": "Vietnam", "lat": 14.0583, "lon": 108.2772},
                {"country": "South Africa", "lat": -30.5595, "lon": 22.9375},
                {"country": "Nepal", "lat": 28.3949, "lon": 84.1240},
                {"country": "Sri Lanka", "lat": 7.8731, "lon": 80.7718},
                {"country": "Malaysia", "lat": 4.2105, "lon": 101.9758}
              ]
            },
            "key": "country",
            "fields": ["lat", "lon"]
          }
        },

        {
          "calculate": "datum.country + '\\n' + format(datum.migrants, ',')",
          "as": "label"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Rubik",
        "fontSize": 12,
        "lineHeight": 16,
        "dx": 8,
        "dy": -8,
        "color": "#333"
      },

      "encoding": {
        "longitude": {"field": "lon"},
        "latitude": {"field": "lat"},
        "text": {"field": "label"}
      }
    },

    {
      "data": {
        "values": [
          {"country": "Australia", "lat": -25.2744, "lon": 133.7751}
        ]
      },
      "mark": {"type": "circle", "color": "#2c3e50", "size": 150},
      "encoding": {
        "longitude": {"field": "lon"},
        "latitude": {"field": "lat"}
      }
    }
  ]
}
